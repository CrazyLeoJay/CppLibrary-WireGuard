{
  "apiType": "stageMode",
  "buildOption": {
    "resOptions": {
      "copyCodeResource": {
        "enable": false
      }
    }
  },
  "buildOptionSet": [
    {
      "name": "release",
      "arkOptions": {
        "obfuscation": {
          "ruleOptions": {
            "enable": false,
            "files": [
              "./obfuscation-rules.txt"
            ]
          }
        }
      }
    },
  ],
  "targets": [
    {
      "name": "default"
    },
    {
      "name": "free",
      "source": {
        "pages": [
          "pages/Index"
        ]
      },
      "resource": {
        "directories": [
          "./src/main/custom/resources",
          "./src/main/resources"
        ]
      }
    },
    {
      "name": "ohosTest",
    }
  ]
}